<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_Number_Required_for_Cases</fullName>
    <active>true</active>
    <description>If Case Status is New, Phone should not be blank.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;New&quot;),
    ISBLANK(SuppliedPhone)
)</errorConditionFormula>
    <errorDisplayField>SuppliedPhone</errorDisplayField>
    <errorMessage>Phone number is required when creating a new Case.</errorMessage>
</ValidationRule>
